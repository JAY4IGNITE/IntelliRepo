# IntelliRepo Environment Configuration Template
# Copy this file to .env (or backend/.env) and configure values for local development.

# ==============================================================================
# Backend Configuration
# ==============================================================================
APP_NAME=IntelliRepo
APP_VERSION=1.0.0
ENVIRONMENT=development

HOST=127.0.0.1
PORT=8000

# PostgreSQL Connection URL
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/intellirepo

# Security & JWT Token Config
SECRET_KEY=replace_this_with_a_secure_random_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# GitHub OAuth App Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/github/callback

# Allowed Frontend Origin URL
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Frontend Configuration
# ==============================================================================
VITE_API_URL=http://127.0.0.1:8000
